# 데이터베이스
DATABASE_URL="postgresql://novaria:novaria@localhost:5432/novaria?schema=public"

# 인증
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# 서버
PORT=3000

# 아래 값들은 아직 실제 연동되지 않은 Mock Provider 자리다.
# 실제 키가 준비되면 각 Provider 구현체를 MockXxxProvider에서 실제 구현체로 교체한다.
MAPBOX_ACCESS_TOKEN=""
LLM_API_KEY=""
PAYMENT_PROVIDER="mock" # mock | toss | kakaopay
